{
  "name": "core",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.15.0"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.25.0",
    "@azure/msal-react": "^5.7.2",
    "@microsoft/applicationinsights-web": "^3.4.3",
    "@sentry/react": "^10.76.2",
    "@tanstack/react-query": "^5.104.2",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "axios": "^1.4.0",
    "govuk-frontend": "^6.1.0",
    "govuk-react": "^0.10.7",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.6.1",
    "styled-components": "^6.3.6",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.1",
    "@eslint/js": "^9.0.0",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.10",
    "@types/react-router-dom": "^5.3.3",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^15.5.2",
    "prettier": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite-plugin-eslint2": "^5.3.0",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "postbuild": "node ./scripts/build-runtime.mjs && node ./scripts/check-headers.mjs",
    "prepare": "cd .. && husky client/.husky"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings 0",
      "prettier --check"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
