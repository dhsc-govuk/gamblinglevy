<Project>

  <!-- Every package version for the eight projects lives here (BLUM-8752); a PackageReference in a csproj
       carries no Version. src/Api/Dockerfile copies this file before its restore layer. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The packages Microsoft ships with each .NET 10 servicing release. One value, so they cannot drift apart. -->
    <MicrosoftPlatformVersion>10.0.13</MicrosoftPlatformVersion>
  </PropertyGroup>

  <ItemGroup Label=".NET servicing band">
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="$(MicrosoftPlatformVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="$(MicrosoftPlatformVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(MicrosoftPlatformVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(MicrosoftPlatformVersion)" />
    <!-- Referenced directly by Infrastructure.csproj. Left transitive, it resolves to the floor the Npgsql
         provider asks for, so the tests would run an older Relational than the one the API publishes. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(MicrosoftPlatformVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="$(MicrosoftPlatformVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftPlatformVersion)" />
    <!-- Security pin, referenced directly by Application.csproj (the reason is stated there). -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="$(MicrosoftPlatformVersion)" />
  </ItemGroup>

  <ItemGroup Label="Application">
    <!-- Pinned to 1.3.4 (not the latest) so its Azure.Storage.Blobs floor (>= 12.16.0) stays inside the
         version already used here; 1.4.0+ needs a newer Azure.Core that collides with Azure.Identity 1.17.2
         (CS0433 on DefaultAzureCredential et al. — both assemblies define the same types). -->
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.3.4" />
    <PackageVersion Include="Azure.Identity" Version="1.17.2" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.19.1" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.8.1" />
    <PackageVersion Include="GovukNotify" Version="7.2.0" />
    <PackageVersion Include="LanguageExt.Core" Version="4.4.7" />
    <!-- Licence ceiling: 12.5.0 is the last Apache-2.0 release. 13.0.0 onwards needs a commercial licence, so
         do not take a major bump here without one. -->
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <PackageVersion Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
    <PackageVersion Include="Microsoft.Graph" Version="5.105.0" />
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.13.2" />
    <!-- Security pin, referenced directly by Infrastructure.csproj (the reason is stated there). -->
    <PackageVersion Include="Microsoft.Kiota.Abstractions" Version="1.22.2" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.19.5" />
    <!-- No code in src uses it, but GovukNotify and SendGrid need it at runtime. Infrastructure.csproj
         references it directly so one version ships and is tested, rather than whichever floor wins. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Otp.NET" Version="1.4.0" />
    <PackageVersion Include="SendGrid" Version="9.29.3" />
    <PackageVersion Include="Sentry.AspNetCore" Version="6.12.1" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <!-- The one pre-release left, on purpose: there is no stable 1.2 (1.1.118 predates records and file-scoped
         namespaces). It is a build-time analyzer with PrivateAssets=all, so it never reaches a deployment. -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- Licence ceiling: 7.x is the last Apache-2.0 line. 8.0.0 onwards needs a commercial licence, so do not
         take a major bump here without one. -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
