{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AzureAd": {
    "Instance": "",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "Domain": ""
  },
  "Graph": {
    "TenantId": "",
    "ApplicationId": "",
    "ApplicationObjectId": "",
    "EnterpriseApplicationObjectId": "",
    "DefaultUserPassword": "",
    "Domain": ""
  },
  "DefaultAdminUser": {
    "Email": "",
    "SubId": ""
  },
  "Sentry": {
    "Dsn": ""
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "SendGrid": {
    "ClientUrl": "",
    "EmailApiKey": "",
    "SenderEmail": ""
  },
  "AzureBlob": {
    "ConnectionString": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Mfa": {
    "SessionExpiryHours": 8,
    "IdleTimeoutMinutes": 30,
    "MaxConcurrentSessions": 5,
    "SessionRetentionDays": 30,
    "SessionRetentionSweepIntervalHours": 6,
    "SessionRetentionSweepBatchSize": 500,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 30,
    "MaxAttemptsPerWindow": 5,
    "RateLimitWindowSeconds": 60
  },
  "InputValidation": {
    "AuditSecurityRejections": true,
    "MaxAuditRowsPerActorPerHour": 3,
    "MaxAuditRowsPerHour": 60
  },
  "RateLimiting": {
    "Enabled": true,
    "Read": { "PermitLimit": 300, "WindowSeconds": 60 },
    "Write": { "PermitLimit": 60, "WindowSeconds": 60 },
    "Export": { "PermitLimit": 10, "WindowSeconds": 300 },
    "Auth": { "PermitLimit": 60, "WindowSeconds": 60 },
    "Global": { "PermitLimit": 1200, "WindowSeconds": 60 },
    "MaxTrackedPartitions": 20000,
    "AuditRateLimitEvents": true,
    "MaxAuditRowsPerActorPerHour": 3,
    "MaxAuditRowsPerHour": 60
  }
}
